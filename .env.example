# Analytics aggregation — salt for user_hash in analytics_aggregated
ANALYTICS_SALT="replace-with-random-salt"

# Admin email for notifications
ADMIN_EMAIL="admin@food-mood.app"
RESEND_FROM_EMAIL="noreply@food-mood.app"

# Free access — VIP / beta
# ADMIN_EMAILS: comma-separated list of emails that always have premium (no payment needed)
ADMIN_EMAILS="you@example.com,collaborator@example.com"
# BETA_ACCESS_CODE: single code that influencers/beta testers enter in /perfil to unlock premium
BETA_ACCESS_CODE="FOODMOOD2026"
